{
  "about": "Shared pay test cases. The web app (public/pay.js), the Mac app (Pay.swift) and the Android app (Pay.kt) must all produce exactly these numbers. date = the day of the clock-in (default 2026-01-01); minutes are real time in Israel (Asia/Jerusalem), so the nights the clock moves are 7 or 9 hours. payAgorot is exact (whole agorot, rounded half up once per shift); pay = payAgorot / 100. shift.rate / emp.rate null = not set. Expected values were worked out independently (Temporal + BigInt), not by the code under test.",
  "cases": [
    { "name": "regular day", "shift": { "in": "08:00", "out": "16:30", "rate": 40 }, "minutes": 510, "payAgorot": 34000 },
    { "name": "overnight", "shift": { "in": "22:00", "out": "06:00", "rate": 40 }, "minutes": 480, "payAgorot": 32000, "overnight": true },
    { "name": "same in and out is zero", "shift": { "in": "08:00", "out": "08:00", "rate": 40 }, "minutes": 0, "payAgorot": 0 },
    { "name": "open shift (no clock-out yet)", "shift": { "in": "08:00", "out": "", "rate": 40 }, "minutes": 0, "payAgorot": 0 },
    { "name": "odd minutes and fractional rate: 215.625 rounds half up", "shift": { "in": "08:07", "out": "13:52", "rate": 37.5 }, "minutes": 345, "payAgorot": 21563 },
    { "name": "10.025 rounds up to 10.03 (float would give 10.02)", "shift": { "in": "08:00", "out": "08:15", "rate": 40.1 }, "minutes": 15, "payAgorot": 1003 },
    { "name": "1.0045 rounds down to 1.00", "shift": { "in": "08:00", "out": "08:07", "rate": 8.61 }, "minutes": 7, "payAgorot": 100 },
    { "name": "less than half an agora is 0", "shift": { "in": "08:00", "out": "08:01", "rate": 0.01 }, "minutes": 1, "payAgorot": 0 },
    { "name": "98.3235 rounds to 98.32", "shift": { "in": "08:00", "out": "08:59", "rate": 99.99 }, "minutes": 59, "payAgorot": 9832 },
    { "name": "longest shift 23:59 at 33.33", "shift": { "in": "00:00", "out": "23:59", "rate": 33.33 }, "minutes": 1439, "payAgorot": 79936 },
    { "name": "special rate for the whole shift", "shift": { "in": "08:00", "out": "16:00", "rate": 40, "special": { "rate": 60, "hours": null } }, "minutes": 480, "payAgorot": 48000 },
    { "name": "special rate for 2 hours", "shift": { "in": "08:00", "out": "16:00", "rate": 40, "special": { "rate": 60, "hours": 2 } }, "minutes": 480, "payAgorot": 36000 },
    { "name": "special for 1.33 hours (79.8 minutes)", "shift": { "in": "08:00", "out": "16:00", "rate": 40, "special": { "rate": 60, "hours": 1.33 } }, "minutes": 480, "payAgorot": 34660 },
    { "name": "special 7.5h at 45.55 in 8:07 at 38.25", "shift": { "in": "08:00", "out": "16:07", "rate": 38.25, "special": { "rate": 45.55, "hours": 7.5 } }, "minutes": 487, "payAgorot": 36521 },
    { "name": "special 0.01 hours", "shift": { "in": "08:00", "out": "08:01", "rate": 0, "special": { "rate": 100, "hours": 0.01 } }, "minutes": 1, "payAgorot": 100 },
    { "name": "special hours capped at shift length", "shift": { "in": "08:00", "out": "10:00", "rate": 40, "special": { "rate": 60, "hours": 5 } }, "minutes": 120, "payAgorot": 12000 },
    { "name": "special without a rate is ignored", "shift": { "in": "08:00", "out": "10:00", "rate": 40, "special": { "rate": null, "hours": 1 } }, "minutes": 120, "payAgorot": 8000 },
    { "name": "overnight with partial special", "shift": { "in": "20:00", "out": "02:00", "rate": 40, "special": { "rate": 50, "hours": 3 } }, "minutes": 360, "payAgorot": 27000, "overnight": true },
    { "name": "falls back to employee rate", "shift": { "in": "08:00", "out": "09:00", "rate": null }, "emp": { "rate": 50 }, "defaultRate": 40, "minutes": 60, "payAgorot": 5000 },
    { "name": "falls back to default rate", "shift": { "in": "08:00", "out": "09:00", "rate": null }, "emp": { "rate": null }, "defaultRate": 40, "minutes": 60, "payAgorot": 4000 },
    { "name": "shift rate wins over employee rate", "shift": { "in": "08:00", "out": "09:30", "rate": 44 }, "emp": { "rate": 50 }, "defaultRate": 40, "minutes": 90, "payAgorot": 6600 },
    { "name": "no rate anywhere", "shift": { "in": "08:00", "out": "09:00", "rate": null }, "emp": null, "defaultRate": null, "minutes": 60, "payAgorot": 0 },

    { "name": "spring forward: the night of 26-27/3/2026 is 7 hours", "date": "2026-03-26", "shift": { "in": "22:00", "out": "06:00", "rate": 40 }, "minutes": 420, "payAgorot": 28000, "overnight": true },
    { "name": "the night after spring forward is 8 hours", "date": "2026-03-27", "shift": { "in": "22:00", "out": "06:00", "rate": 40 }, "minutes": 480, "payAgorot": 32000, "overnight": true },
    { "name": "day shift on the spring forward day is normal", "date": "2026-03-27", "shift": { "in": "08:00", "out": "16:00", "rate": 40 }, "minutes": 480, "payAgorot": 32000 },
    { "name": "spring forward 23:30-03:30 is 3 hours", "date": "2026-03-26", "shift": { "in": "23:30", "out": "03:30", "rate": 40 }, "minutes": 180, "payAgorot": 12000, "overnight": true },
    { "name": "a time skipped in spring moves forward (02:30 is 03:30)", "date": "2026-03-27", "shift": { "in": "02:30", "out": "06:00", "rate": 40 }, "minutes": 150, "payAgorot": 10000 },
    { "name": "01:00 to the skipped 02:30 is 1.5 hours", "date": "2026-03-27", "shift": { "in": "01:00", "out": "02:30", "rate": 40 }, "minutes": 90, "payAgorot": 6000 },
    { "name": "skipped 02:10 to 03:20 is 10 minutes", "date": "2026-03-27", "shift": { "in": "02:10", "out": "03:20", "rate": 40 }, "minutes": 10, "payAgorot": 667 },
    { "name": "fall back: the night of 24-25/10/2026 is 9 hours", "date": "2026-10-24", "shift": { "in": "22:00", "out": "06:00", "rate": 40 }, "minutes": 540, "payAgorot": 36000, "overnight": true },
    { "name": "fall back 00:30-03:00 is 3.5 hours", "date": "2026-10-25", "shift": { "in": "00:30", "out": "03:00", "rate": 40 }, "minutes": 210, "payAgorot": 14000 },
    { "name": "inside the repeated hour: the earlier one", "date": "2026-10-25", "shift": { "in": "01:10", "out": "01:50", "rate": 40 }, "minutes": 40, "payAgorot": 2667 },
    { "name": "ending in the repeated hour: the earlier one", "date": "2026-10-24", "shift": { "in": "23:00", "out": "01:30", "rate": 40 }, "minutes": 150, "payAgorot": 10000, "overnight": true },
    { "name": "fall back night with a special rate for all of it", "date": "2026-10-24", "shift": { "in": "22:00", "out": "06:00", "rate": 40, "special": { "rate": 55, "hours": null } }, "minutes": 540, "payAgorot": 49500, "overnight": true },
    { "name": "spring forward 2027 (night of 25-26/3)", "date": "2027-03-25", "shift": { "in": "22:00", "out": "06:00", "rate": 40 }, "minutes": 420, "payAgorot": 28000, "overnight": true },
    { "name": "fall back 2027 (night of 30-31/10)", "date": "2027-10-30", "shift": { "in": "22:00", "out": "06:00", "rate": 40 }, "minutes": 540, "payAgorot": 36000, "overnight": true },
    { "name": "fall back 2028 (night of 28-29/10)", "date": "2028-10-28", "shift": { "in": "22:00", "out": "06:00", "rate": 40 }, "minutes": 540, "payAgorot": 36000, "overnight": true },

    { "name": "not a real date: by the clock on the wall", "date": "2026-02-30", "shift": { "in": "22:00", "out": "06:00", "rate": 40 }, "minutes": 480, "payAgorot": 32000, "overnight": true },
    { "name": "one-digit hour is accepted", "shift": { "in": "8:00", "out": "16:00", "rate": 40 }, "minutes": 480, "payAgorot": 32000 },
    { "name": "time with seconds is not valid", "shift": { "in": "08:00:00", "out": "16:00", "rate": 40 }, "minutes": 0, "payAgorot": 0 },
    { "name": "24:00 is not valid", "shift": { "in": "24:00", "out": "06:00", "rate": 40 }, "minutes": 0, "payAgorot": 0 },
    { "name": "minutes above 59 are not valid", "shift": { "in": "08:00", "out": "16:60", "rate": 40 }, "minutes": 0, "payAgorot": 0 }
  ]
}
