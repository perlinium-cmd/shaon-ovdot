<?xml version="1.0" encoding="utf-8"?>
<!-- Back up only the connection (so a restored phone reconnects by itself). Firestore's cache is not backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
