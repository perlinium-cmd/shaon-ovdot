rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */

    function signedIn() { return request.auth != null; }

    // The manager: a real (Google) account working in its own space. Phones sign in anonymously.
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function devPath(owner) { return /databases/$(database)/documents/users/$(owner)/devices/$(request.auth.uid); }
    // A phone that the manager connected to one of their employees.
    function isDevice(owner) { return signedIn() && exists(devPath(owner)); }
    function devEmp(owner) { return get(devPath(owner)).data.empId; }
    function ofMyEmp(owner, data) { return isDevice(owner) && data.empId == devEmp(owner); }

    function isTime(t) { return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function isDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function nowMs() { return request.time.toMillis(); }

    /* ---------- the manager's private space ---------- */

    // Each Google account has its own private space. Nobody can see anyone else's data.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    /* ---------- pairing a phone ---------- */

    function pairPath(code) { return /databases/$(database)/documents/pairings/$(code); }

    match /pairings/{code} {
      // The manager creates a short-lived code for one of their employees.
      allow create: if isOwner(request.resource.data.ownerUid)
        && code.matches('^[A-Z0-9]{8,64}$')
        && request.resource.data.keys().hasOnly(['ownerUid', 'empId', 'empName', 'expiresAt', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm')
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/employees/$(request.resource.data.empId));
      allow read, delete: if isOwner(resource.data.ownerUid);

      // A phone looks up the code it was given (single get, never a list) while it is unused and valid…
      allow get: if signedIn() && resource.data.expiresAt > request.time && !('usedBy' in resource.data);
      // …and marks it used, in the same batch that creates its device record.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && !('usedBy' in resource.data)
        && resource.data.expiresAt > request.time
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(resource.data.ownerUid)/devices/$(request.auth.uid)).data.pairCode == code;
    }

    function keyPath(owner, key) { return /databases/$(database)/documents/users/$(owner)/deviceKeys/$(key); }

    function pairingOk(owner, d) {
      let before = get(pairPath(d.pairCode)).data;
      let after = getAfter(pairPath(d.pairCode)).data;
      return d.pairCode is string
        && before.ownerUid == owner && before.empId == d.empId
        && before.expiresAt > request.time && !('usedBy' in before)
        && after.usedBy == request.auth.uid
        // A new reconnect key is created in the same batch.
        && !exists(keyPath(owner, d.keyId))
        && getAfter(keyPath(owner, d.keyId)).data.deviceId == request.auth.uid;
    }

    // "Connect once, forever": after a reinstall or on a new phone, the app reconnects
    // by itself with the secret key it kept in Google's Block Store.
    function rejoinOk(owner, d) {
      let before = get(keyPath(owner, d.keyId)).data;
      return !('pairCode' in d)
        && before.empId == d.empId
        && getAfter(keyPath(owner, d.keyId)).data.deviceId == request.auth.uid;
    }

    match /users/{owner}/devices/{deviceId} {
      // A phone can check that it is still connected (the manager disconnects it by deleting this doc).
      allow get: if signedIn() && request.auth.uid == deviceId;
      // A phone connects itself with a valid, unused code, or reconnects with its key.
      allow create: if signedIn() && request.auth.uid == deviceId
        && request.resource.data.keys().hasOnly(['empId', 'pairCode', 'keyId', 'model', 'pairedAt'])
        && request.resource.data.keyId is string
        && request.resource.data.model is string && request.resource.data.model.size() <= 80
        && request.resource.data.pairedAt == request.time
        && (pairingOk(owner, request.resource.data) || rejoinOk(owner, request.resource.data));
      // When reconnecting, the old (dead) install's record is removed in the same batch.
      allow delete: if signedIn() && request.auth.uid != deviceId
        && resource.data.keyId is string
        && getAfter(keyPath(owner, resource.data.keyId)).data.deviceId == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(owner)/devices/$(request.auth.uid)).data.keyId == resource.data.keyId;
    }

    match /users/{owner}/deviceKeys/{key} {
      // Knowing the long random key is the proof. Single get only, never a list.
      allow get: if signedIn();
      // Created together with the device record during pairing.
      allow create: if signedIn() && key.matches('^[A-Za-z0-9]{40,64}$')
        && request.resource.data.keys().hasOnly(['empId', 'deviceId', 'createdAt'])
        && request.resource.data.deviceId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(devPath(owner)).data.keyId == key
        && getAfter(devPath(owner)).data.empId == request.resource.data.empId;
      // Moved to the new install when reconnecting.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId'])
        && request.resource.data.deviceId == request.auth.uid
        && getAfter(devPath(owner)).data.keyId == key;
    }

    // Survives uninstall/reinstall: the id is a hash of the phone's app-scoped Android ID, which only this app
    // on this phone can compute. It points to the phone's reconnect key; once the manager deletes that key
    // (disconnect), the card is useless.
    match /restore/{rid} {
      allow get: if signedIn() && rid.matches('^[a-f0-9]{64}$');
      allow create, update: if signedIn() && rid.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['ownerUid', 'empId', 'empName', 'keyId', 'deviceUid'])
        && request.resource.data.deviceUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/devices/$(request.auth.uid)).data.keyId == request.resource.data.keyId
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/devices/$(request.auth.uid)).data.empId == request.resource.data.empId;
    }

    /* ---------- what a connected phone may see and do ---------- */

    match /users/{owner}/settings/{docId} {
      allow get: if docId == 'main' && isDevice(owner);
    }

    match /users/{owner}/employees/{empId} {
      allow get: if isDevice(owner) && devEmp(owner) == empId;
    }

    match /users/{owner}/payments/{payId} {
      allow read: if ofMyEmp(owner, resource.data);
    }

    function clockIn(d) {
      return d.keys().hasOnly(['empId', 'date', 'month', 'in', 'out', 'inAt', 'syncedAt', 'source', 'open', 'createdAt', 'deviceId'])
        && d.keys().hasAll(['empId', 'date', 'month', 'in', 'out', 'inAt', 'syncedAt', 'source', 'open', 'deviceId'])
        && d.source == 'phone' && d.open == true && d.out == ''
        && d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && isDate(d.date) && d.date.matches(d.month + '-[0-9]{2}')
        && isTime(d.in)
        // Phone clock, so offline clock-ins keep their real time; the server time is kept next to it.
        && d.inAt is number && d.inAt > nowMs() - 14 * 86400000 && d.inAt < nowMs() + 3600000
        && d.syncedAt == request.time
        && d.deviceId == request.auth.uid
        && (!('createdAt' in d) || d.createdAt is number);
    }

    function clockOut(before, after) {
      return before.open == true && after.open == false
        && isTime(after.out)
        && after.outAt is number && after.outAt >= before.inAt && after.outAt < nowMs() + 3600000
        && after.outSyncedAt == request.time;
    }

    // "Undo" right after clocking out reopens the shift.
    function undoClockOut(before, after) {
      return before.open == false && after.open == true && after.out == ''
        && !('outAt' in after) && !('outSyncedAt' in after)
        && request.time < before.outSyncedAt + duration.value(10, 'm');
    }

    /* What the phone saves without approval comes with a notice for the manager, written in the same batch,
       so it can't be skipped. The phone can add notices but never read them. */
    function noticePath(owner, id) { return /databases/$(database)/documents/users/$(owner)/notices/$(id); }
    function withNotice(owner, shiftId, d) {
      return d.noticeId is string && getAfter(noticePath(owner, d.noticeId)).data.shiftId == shiftId;
    }
    function hoursAgo(h) { return nowMs() - h * 3600000; }

    // A shift she forgot to clock, typed in on the day it ended (the app allows that day only;
    // the 48 hours here leave room for a phone that was offline). Older ones go through a request.
    function manualShift(owner, shiftId, d) {
      return d.keys().hasOnly(['empId', 'date', 'month', 'in', 'out', 'inAt', 'outAt', 'syncedAt', 'source', 'open', 'manual', 'createdAt', 'deviceId', 'noticeId'])
        && d.keys().hasAll(['empId', 'date', 'month', 'in', 'out', 'inAt', 'outAt', 'syncedAt', 'source', 'open', 'manual', 'deviceId', 'noticeId'])
        && d.source == 'phone' && d.open == false && d.manual == true
        && d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && isDate(d.date) && d.date.matches(d.month + '-[0-9]{2}')
        && isTime(d.in) && isTime(d.out) && d.in != d.out
        && d.inAt is number && d.outAt is number
        && d.outAt > d.inAt && d.outAt - d.inAt <= 24 * 3600000
        && d.outAt > hoursAgo(48) && d.outAt < nowMs() + 600000
        && d.syncedAt == request.time
        && d.deviceId == request.auth.uid
        && (!('createdAt' in d) || d.createdAt is number)
        && withNotice(owner, shiftId, d);
    }

    // She remembered a little later that she came in, or left, earlier than she pressed. Moving a time
    // earlier is saved without approval; a later time, or an older shift, still needs a request.
    function earlierFix(owner, shiftId, b, a) {
      return a.edited == true
        && a.noticeId != b.get('noticeId', '') && withNotice(owner, shiftId, a)
        && isTime(a.in) && a.inAt is number
        && a.inAt <= b.inAt && a.inAt > b.inAt - 12 * 3600000
        && (a.inAt != b.inAt || a.in == b.in)
        && (
          // still running, clock-in moved earlier
          (b.open == true && a.open == true && a.out == '' && !('outAt' in a) && a.inAt < b.inAt)
          // clocking out now, at the time she really left
          || (b.open == true && a.open == false && isTime(a.out) && a.outAt is number
              && a.outAt > a.inAt && a.outAt < nowMs() + 3600000 && a.outSyncedAt == request.time)
          // a finished shift, shortly after it ended: earlier clock-in and/or earlier clock-out
          || (b.open == false && a.open == false && isTime(a.out) && a.outAt is number
              && a.outAt <= b.outAt && a.outAt > a.inAt
              && (a.outAt != b.outAt || a.out == b.out)
              && (a.inAt < b.inAt || a.outAt < b.outAt)
              && b.outAt > hoursAgo(48))
        );
    }

    match /users/{owner}/shifts/{shiftId} {
      allow read: if ofMyEmp(owner, resource.data);
      allow create: if ofMyEmp(owner, request.resource.data)
        && (clockIn(request.resource.data) || manualShift(owner, shiftId, request.resource.data));
      allow update: if ofMyEmp(owner, resource.data)
        && resource.data.get('source', '') == 'phone'
        && resource.data.get('paid', false) != true
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['out', 'outAt', 'outSyncedAt', 'open'])
            && (clockOut(resource.data, request.resource.data) || undoClockOut(resource.data, request.resource.data)))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['in', 'inAt', 'out', 'outAt', 'outSyncedAt', 'open', 'edited', 'noticeId'])
            && earlierFix(owner, shiftId, resource.data, request.resource.data))
        );
      // "Undo" right after clocking in: only a phone shift that is still open and a few minutes old.
      allow delete: if ofMyEmp(owner, resource.data)
        && resource.data.get('source', '') == 'phone'
        && resource.data.get('open', false) == true
        && resource.data.get('paid', false) != true
        && request.time < resource.data.syncedAt + duration.value(10, 'm');
    }

    match /users/{owner}/notices/{noticeId} {
      allow create: if ofMyEmp(owner, request.resource.data)
        && request.resource.data.keys().hasOnly(['empId', 'type', 'shiftId', 'date', 'in', 'out', 'prevIn', 'prevOut', 'createdAt', 'deviceId'])
        && request.resource.data.keys().hasAll(['empId', 'type', 'shiftId', 'date', 'in', 'out', 'createdAt', 'deviceId'])
        && request.resource.data.type in ['manual', 'fix']
        && request.resource.data.createdAt == request.time
        && request.resource.data.deviceId == request.auth.uid
        && isDate(request.resource.data.date) && isTime(request.resource.data.in)
        && (isTime(request.resource.data.out) || request.resource.data.out == '')
        && request.resource.data.shiftId is string
        && getAfter(/databases/$(database)/documents/users/$(owner)/shifts/$(request.resource.data.shiftId)).data.get('noticeId', '') == noticeId;
    }

    function newRequest(owner, d) {
      return d.keys().hasOnly(['empId', 'type', 'shiftId', 'date', 'in', 'out', 'note', 'status', 'createdAt', 'deviceId'])
        && d.keys().hasAll(['empId', 'type', 'date', 'in', 'out', 'status', 'createdAt', 'deviceId'])
        && d.status == 'pending' && d.createdAt == request.time && d.deviceId == request.auth.uid
        && isDate(d.date) && isTime(d.in)
        // out may stay empty only when fixing the clock-in of a shift that is still running
        && (isTime(d.out) || (d.type == 'fix' && d.out == ''))
        && (!('note' in d) || (d.note is string && d.note.size() <= 500))
        && (d.type == 'add'
          || (d.type == 'fix' && d.shiftId is string
            && get(/databases/$(database)/documents/users/$(owner)/shifts/$(d.shiftId)).data.empId == d.empId));
    }

    // Correction requests: the phone asks, the manager decides.
    match /users/{owner}/requests/{reqId} {
      allow read: if ofMyEmp(owner, resource.data);
      allow create: if ofMyEmp(owner, request.resource.data) && newRequest(owner, request.resource.data);
      // The phone can withdraw its own request while it is still pending.
      allow update: if ofMyEmp(owner, resource.data) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.decidedAt == request.time;
    }

    /* ---------- legacy ---------- */

    // Legacy data from before per-user spaces: read-only for the original owner,
    // only so the app can copy it into their private space once.
    match /{collection}/{docId} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'cr.perlinium@gmail.com'
        && collection in ['settings', 'employees', 'shifts'];
    }
  }
}
