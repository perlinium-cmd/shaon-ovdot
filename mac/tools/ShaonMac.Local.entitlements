<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Only unrestricted entitlements: no provisioning profile is needed, so the app never expires
       (same approach as the Perli app). Login is stored in the file-based keychain - see
       tools/patch-deps.py. -->
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.print</key><true/>
</dict>
</plist>
